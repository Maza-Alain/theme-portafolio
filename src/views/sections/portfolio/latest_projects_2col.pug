.text-center.mt-70.mb-50
    h2.color-linear.d-inline-block.mb-20.wow.animate__animated.animate__fadeInUp My Latest Projects
.mt-70
    .row.justify-content-center
        -
            const articleLists = [
                {
                    image: 'assets/imgs/page/about/img7.png',
                    title: 'Cluster de kubernetes con raspberry pi',
                    description: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nullam volutpat vitae risus eget maximus. Pellentesque suscipit',
                    link: 'kubernetes-cluster-raspberry.html',
                    type: 'video',
                    delay: '.0s',
                    dataFilter: 'web motion'
                },
            ]
        each post in articleLists
            .col-lg-6
                .project(data-category= post.dataFilter)
                    .item-content
                        .card-style-1.hover-up.mb-30(data-wow-delay= post.delay)
                            .card-image
                                a.link-post(href= post.link)
                                    img(src= post.image, alt="Genz")
                                    .card-info.card-bg-2
                                        .info-bottom.mb-15
                                            h3.color-white.mb-10= post.title
                                            p.color-gray-500.text-sm= post.description
