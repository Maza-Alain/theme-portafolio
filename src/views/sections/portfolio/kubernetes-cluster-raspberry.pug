.row.mt-30.mb-50
    .swiper-container.swiper-group-2
        .swiper-wrapper.wow.animate__animated.animate__fadeIn
            //- Fotos del hardware: Raspberry en su case con la UPS HAT, el SSD, el host VMware, etc.
